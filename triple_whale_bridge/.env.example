# Triple Whale Bridge Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Required Configuration
# =============================================================================

# Triple Whale API Key
# Create at: Triple Whale Dashboard > Settings > API Keys
# Required scope: Orders: Write
TRIPLE_WHALE_API_KEY=tw_your_api_key_here

# =============================================================================
# Optional Security Configuration
# =============================================================================

# Webhook Secret (optional)
# If set, all webhook requests must include X-Webhook-Secret header
WEBHOOK_SECRET=

# GoHighLevel Webhook Secret (optional)
# If set, validates X-GHL-Signature header
GHL_WEBHOOK_SECRET=

# =============================================================================
# Optional Service Configuration
# =============================================================================

# Server settings
PORT=8000
HOST=0.0.0.0

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Custom pipeline config path (optional)
# Leave empty to use default config/pipeline_mappings.yaml
PIPELINE_CONFIG_PATH=

# Triple Whale API base URL (optional, for testing)
TRIPLE_WHALE_BASE_URL=https://api.triplewhale.com/api/v2

# Request timeout in seconds
TRIPLE_WHALE_TIMEOUT=30
